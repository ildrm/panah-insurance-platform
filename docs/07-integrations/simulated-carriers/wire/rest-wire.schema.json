{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insurance.example.invalid/simulator/rest-wire.schema.json",
  "title": "Fictional REST carrier wire types",
  "$defs": {
    "QuoteRequest": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "quote_request"
        },
        "clientApplicationRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "productCode": {
          "const": "SIM-MOTOR"
        },
        "risk": {
          "type": "object",
          "properties": {
            "subjectRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "manufactureYear": {
              "type": "integer",
              "minimum": 2000,
              "maximum": 2030
            }
          },
          "required": [
            "subjectRef",
            "manufactureYear"
          ],
          "additionalProperties": false
        },
        "effectiveDate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10,
          "format": "date"
        }
      },
      "required": [
        "kind",
        "clientApplicationRef",
        "productCode",
        "risk",
        "effectiveDate"
      ],
      "additionalProperties": false
    },
    "QuoteResponse": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "quote"
        },
        "quoteRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "premium": {
          "type": "object",
          "properties": {
            "amount": {
              "type": "string",
              "minLength": 1,
              "maxLength": 24,
              "pattern": "^(0|[1-9][0-9]{0,23})$"
            },
            "currency": {
              "const": "IRR"
            },
            "unit": {
              "const": "rial"
            }
          },
          "required": [
            "amount",
            "currency",
            "unit"
          ],
          "additionalProperties": false
        },
        "expiresAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "format": "date-time"
        },
        "mappingVersion": {
          "const": "map-v1"
        }
      },
      "required": [
        "kind",
        "quoteRef",
        "premium",
        "expiresAt",
        "mappingVersion"
      ],
      "additionalProperties": false
    },
    "SubmitRequest": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "submission_request"
        },
        "clientApplicationRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "quoteRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "acceptedPremium": {
          "type": "object",
          "properties": {
            "amount": {
              "type": "string",
              "minLength": 1,
              "maxLength": 24,
              "pattern": "^(0|[1-9][0-9]{0,23})$"
            },
            "currency": {
              "const": "IRR"
            },
            "unit": {
              "const": "rial"
            }
          },
          "required": [
            "amount",
            "currency",
            "unit"
          ],
          "additionalProperties": false
        },
        "effectiveDate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10,
          "format": "date"
        },
        "mappingVersion": {
          "const": "map-v1"
        }
      },
      "required": [
        "kind",
        "clientApplicationRef",
        "quoteRef",
        "acceptedPremium",
        "effectiveDate",
        "mappingVersion"
      ],
      "additionalProperties": false
    },
    "Acknowledgment": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "submission_ack"
        },
        "externalRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "acknowledgedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "format": "date-time"
        },
        "issuanceState": {
          "const": "pending"
        }
      },
      "required": [
        "kind",
        "externalRef",
        "acknowledgedAt",
        "issuanceState"
      ],
      "additionalProperties": false
    },
    "StatusRequest": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "status_request"
        },
        "clientApplicationRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "required": [
        "kind",
        "clientApplicationRef"
      ],
      "additionalProperties": false
    },
    "Status": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "status"
        },
        "clientApplicationRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "externalRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "submissionState": {
          "const": "acknowledged"
        },
        "issuanceState": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "enum": [
            "pending",
            "issued"
          ]
        },
        "observedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "format": "date-time"
        },
        "policy": {
          "type": "object",
          "properties": {
            "policyRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "effectiveFrom": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10,
              "format": "date"
            },
            "effectiveUntilExclusive": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10,
              "format": "date"
            },
            "documentRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          },
          "required": [
            "policyRef",
            "effectiveFrom",
            "effectiveUntilExclusive",
            "documentRef"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "clientApplicationRef",
        "externalRef",
        "submissionState",
        "issuanceState",
        "observedAt"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "issuanceState": {
                "const": "issued"
              }
            }
          },
          "then": {
            "required": [
              "policy"
            ]
          },
          "else": {
            "not": {
              "required": [
                "policy"
              ]
            }
          }
        }
      ]
    },
    "NotFound": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "not_found"
        },
        "clientApplicationRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "authoritative": {
          "type": "boolean"
        },
        "pollOrdinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "kind",
        "clientApplicationRef",
        "authoritative",
        "pollOrdinal"
      ],
      "additionalProperties": false
    },
    "Reject": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "rejection"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "enum": [
            "risk_ineligible",
            "quote_expired",
            "amount_mismatch",
            "invalid_schema",
            "idempotency_conflict",
            "unauthorized",
            "throttled",
            "unavailable"
          ]
        },
        "accepted": {
          "const": false
        },
        "retriable": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "code",
        "accepted",
        "retriable"
      ],
      "additionalProperties": false
    },
    "DocumentRequest": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "document_request"
        },
        "policyRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "required": [
        "kind",
        "policyRef"
      ],
      "additionalProperties": false
    },
    "Document": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "document"
        },
        "documentRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "mediaType": {
          "const": "application/pdf"
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "contentBase64": {
          "type": "string",
          "minLength": 1,
          "maxLength": 43692,
          "contentEncoding": "base64"
        }
      },
      "required": [
        "kind",
        "documentRef",
        "mediaType",
        "sha256",
        "sizeBytes",
        "contentBase64"
      ],
      "additionalProperties": false
    },
    "TransportUnknown": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "transport_unknown"
        },
        "scenario": {
          "const": "timeout_after_acceptance"
        },
        "responseReceived": {
          "const": false
        },
        "requestMayHaveBeenAccepted": {
          "const": true
        },
        "expectedLocalState": {
          "const": "external_outcome_unknown"
        },
        "automaticResubmitAllowed": {
          "const": false
        }
      },
      "required": [
        "kind",
        "scenario",
        "responseReceived",
        "requestMayHaveBeenAccepted",
        "expectedLocalState",
        "automaticResubmitAllowed"
      ],
      "additionalProperties": false
    }
  }
}
