{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insurance.example.invalid/simulator/fixture-manifest.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "const": "SIM-WIRE-FIXTURES"
    },
    "version": {
      "const": "1.0.0"
    },
    "status": {
      "const": "synthetic"
    },
    "jsonFixtures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "definition": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "valid": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "schema",
          "definition",
          "valid"
        ],
        "additionalProperties": false
      }
    },
    "xmlFixtures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "payloadElement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "path",
          "payloadElement",
          "schema"
        ],
        "additionalProperties": false
      }
    },
    "signingVectors": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "calendarPair": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "document": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "id",
    "version",
    "status",
    "jsonFixtures",
    "xmlFixtures",
    "signingVectors",
    "calendarPair",
    "document"
  ],
  "additionalProperties": false
}
