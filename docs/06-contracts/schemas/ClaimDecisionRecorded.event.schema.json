{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insurance.example.invalid/schemas/ClaimDecisionRecorded.event.schema.json",
  "title": "ClaimDecisionRecorded",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "claim.decision.recorded.v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "causationId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "contextRef": {
      "type": "string",
      "format": "uuid"
    },
    "data": {
      "type": "object",
      "properties": {
        "claimId": {
          "type": "string",
          "format": "uuid"
        },
        "decisionVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "decision": {
          "type": "string",
          "enum": [
            "approved",
            "rejected",
            "evidence_required"
          ]
        },
        "authorityRef": {
          "type": "string",
          "format": "uuid"
        },
        "privateDecisionSnapshotRef": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "claimId",
        "decisionVersion",
        "decision",
        "authorityRef",
        "privateDecisionSnapshotRef"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "correlationId",
    "aggregateId",
    "aggregateVersion",
    "contextRef",
    "data"
  ],
  "additionalProperties": false
}
