{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insurance.example.invalid/schemas/PurchaseCommitted.event.schema.json",
  "title": "PurchaseCommitted",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "purchase.committed.v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "causationId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "contextRef": {
      "type": "string",
      "format": "uuid"
    },
    "data": {
      "type": "object",
      "properties": {
        "purchaseId": {
          "type": "string",
          "format": "uuid"
        },
        "purchaseVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "commitmentKind": {
          "type": "string",
          "enum": [
            "verified_payment",
            "approved_credit",
            "approved_invoice"
          ]
        },
        "snapshotRef": {
          "type": "string",
          "format": "uuid"
        },
        "recipientProjectionRef": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "purchaseId",
        "purchaseVersion",
        "commitmentKind",
        "snapshotRef",
        "recipientProjectionRef"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "correlationId",
    "aggregateId",
    "aggregateVersion",
    "contextRef",
    "data"
  ],
  "additionalProperties": false
}
