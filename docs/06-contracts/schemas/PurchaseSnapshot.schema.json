{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insurance.example.invalid/schemas/PurchaseSnapshot.schema.json",
  "title": "PurchaseSnapshot",
  "type": "object",
  "properties": {
    "purchaseId": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "contextId": {
      "type": "string",
      "format": "uuid"
    },
    "channel": {
      "type": "string",
      "enum": [
        "b2c",
        "corporate",
        "commercial",
        "reseller",
        "b2b2c"
      ]
    },
    "productId": {
      "type": "string",
      "pattern": "^PRD-[0-9]{2}$"
    },
    "carrierId": {
      "type": "string",
      "format": "uuid"
    },
    "parties": {
      "type": "array",
      "minItems": 3,
      "maxItems": 100,
      "items": {
        "$ref": "PartyRole.schema.json"
      }
    },
    "commitmentKind": {
      "type": "string",
      "enum": [
        "verified_payment",
        "approved_credit",
        "approved_invoice"
      ]
    },
    "paymentReceiptIds": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "approvalId": {
      "type": "string",
      "format": "uuid"
    },
    "creditReservationId": {
      "type": "string",
      "format": "uuid"
    },
    "versions": {
      "$ref": "SnapshotVersions.schema.json"
    },
    "riskSnapshotRef": {
      "type": "string",
      "format": "uuid"
    },
    "evidenceManifestRef": {
      "type": "string",
      "format": "uuid"
    },
    "recipientProjectionRef": {
      "type": "string",
      "format": "uuid"
    },
    "totalPayable": {
      "$ref": "Money.schema.json"
    },
    "allocations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "Allocation.schema.json"
      }
    },
    "committedAt": {
      "type": "string",
      "format": "date-time"
    },
    "insuredScheduleRef": {
      "type": "string",
      "format": "uuid"
    }
  },
  "required": [
    "purchaseId",
    "version",
    "contextId",
    "channel",
    "productId",
    "carrierId",
    "parties",
    "commitmentKind",
    "versions",
    "riskSnapshotRef",
    "evidenceManifestRef",
    "recipientProjectionRef",
    "totalPayable",
    "allocations",
    "committedAt"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "commitmentKind": {
          "const": "verified_payment"
        },
        "paymentReceiptIds": {
          "minItems": 1
        }
      },
      "required": [
        "paymentReceiptIds"
      ]
    },
    {
      "properties": {
        "commitmentKind": {
          "enum": [
            "approved_credit",
            "approved_invoice"
          ]
        }
      },
      "required": [
        "approvalId",
        "creditReservationId"
      ],
      "not": {
        "required": [
          "paymentReceiptIds"
        ]
      }
    }
  ]
}
