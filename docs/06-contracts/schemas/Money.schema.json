{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insurance.example.invalid/schemas/Money.schema.json",
  "title": "Money",
  "type": "object",
  "properties": {
    "amount": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,23})$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "unit": {
      "type": "string",
      "enum": [
        "minor",
        "rial"
      ]
    }
  },
  "required": [
    "amount",
    "currency",
    "unit"
  ],
  "additionalProperties": false
}
