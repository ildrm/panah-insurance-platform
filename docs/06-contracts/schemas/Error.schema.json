{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insurance.example.invalid/schemas/Error.schema.json",
  "title": "Error",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "messageKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "retriable": {
      "type": "boolean"
    },
    "fieldErrors": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          }
        },
        "required": [
          "field",
          "code"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "code",
    "messageKey",
    "correlationId",
    "retriable"
  ],
  "additionalProperties": false
}
