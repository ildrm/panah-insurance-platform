{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insurance.example.invalid/schemas/DocumentsReviewEvidenceDocumentRecordedV1.event.schema.json",
  "title": "DocumentsReviewEvidenceDocumentRecordedV1",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "documents.review-evidence-document.recorded.v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "causationId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "contextRef": {
      "type": "string",
      "format": "uuid"
    },
    "data": {
      "type": "object",
      "properties": {
        "resourceId": {
          "type": "string",
          "format": "uuid"
        },
        "resourceVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "snapshotRef": {
          "type": "string",
          "format": "uuid"
        },
        "recipientProjectionRef": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "resourceId",
        "resourceVersion",
        "operationId",
        "snapshotRef",
        "recipientProjectionRef"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "correlationId",
    "aggregateId",
    "aggregateVersion",
    "contextRef",
    "data"
  ],
  "additionalProperties": false
}
