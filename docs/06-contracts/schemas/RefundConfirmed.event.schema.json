{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insurance.example.invalid/schemas/RefundConfirmed.event.schema.json",
  "title": "RefundConfirmed",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "refund.confirmed.v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "causationId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "contextRef": {
      "type": "string",
      "format": "uuid"
    },
    "data": {
      "type": "object",
      "properties": {
        "refundId": {
          "type": "string",
          "format": "uuid"
        },
        "receiptId": {
          "type": "string",
          "format": "uuid"
        },
        "journalId": {
          "type": "string",
          "format": "uuid"
        },
        "providerEvidenceRef": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "refundId",
        "receiptId",
        "journalId",
        "providerEvidenceRef"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "correlationId",
    "aggregateId",
    "aggregateVersion",
    "contextRef",
    "data"
  ],
  "additionalProperties": false
}
