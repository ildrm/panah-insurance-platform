{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insurance.example.invalid/schemas/operational-policy-defaults.schema.json",
  "title": "Proposed operational policy defaults schema",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "version",
    "owner_role",
    "reviewer_roles",
    "scope_ids",
    "source_refs",
    "assumption_refs",
    "updated",
    "schema_ref",
    "description",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "const": "proposed"
    },
    "version": {
      "const": "1.0.0"
    },
    "owner_role": {
      "type": "string",
      "pattern": "^R[0-9]{2}$"
    },
    "reviewer_roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumption_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "schema_ref": {
      "const": "operational-policy-defaults.schema.json"
    },
    "description": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "control",
          "value",
          "unit",
          "rationale",
          "verification"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "control": {
            "type": "string"
          },
          "value": {
            "type": [
              "integer",
              "string",
              "boolean"
            ]
          },
          "unit": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "verification": {
            "type": "string"
          }
        }
      }
    }
  }
}
