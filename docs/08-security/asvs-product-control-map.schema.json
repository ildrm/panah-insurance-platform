{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insurance.example.invalid/schemas/asvs-product-control-map.schema.json",
  "type": "object",
  "required": [
    "id",
    "title",
    "version",
    "status",
    "owner_role",
    "updated",
    "schema_ref",
    "reviewer_roles",
    "scope_ids",
    "source_refs",
    "assumption_refs",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "owner_role": {
      "type": "string"
    },
    "updated": {
      "type": "string"
    },
    "schema_ref": {
      "type": "string"
    },
    "reviewer_roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumption_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entries": {
      "type": "array",
      "minItems": 13,
      "items": {
        "type": "object",
        "required": [
          "id",
          "threat",
          "standard",
          "standard_version",
          "checked",
          "status",
          "owner_role",
          "specification_path",
          "control",
          "requirement_ids",
          "source_refs",
          "reviewer_roles",
          "test_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "threat": {
            "type": "string"
          },
          "standard": {
            "type": "string"
          },
          "standard_version": {
            "const": "5.0.0"
          },
          "checked": {
            "type": "string"
          },
          "status": {
            "const": "design-mapped-not-tested"
          },
          "owner_role": {
            "type": "string"
          },
          "specification_path": {
            "type": "string"
          },
          "control": {
            "type": "string"
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "reviewer_roles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "test_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
