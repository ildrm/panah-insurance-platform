{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insurance.example.invalid/meta/document-metadata.schema.json",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "version",
    "owner_role",
    "reviewer_roles",
    "scope_ids",
    "source_refs",
    "assumption_refs",
    "updated"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "proposed",
        "partial",
        "reviewed",
        "accepted"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "owner_role": {
      "type": "string",
      "pattern": "^R(0[1-9]|1[0-9]|2[01])$"
    },
    "reviewer_roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^R(0[1-9]|1[0-9]|2[01])$"
      }
    },
    "scope_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^S[0-9]{2}$"
      }
    },
    "assumption_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^A[0-9]{2}$"
      }
    },
    "updated": {
      "type": "string",
      "format": "date"
    }
  },
  "additionalProperties": false
}
