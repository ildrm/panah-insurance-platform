{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insurance.example.invalid/meta/document-manifest.schema.json",
  "type": "object",
  "required": [
    "id",
    "version",
    "status",
    "updated",
    "entries"
  ],
  "properties": {
    "id": {
      "const": "REG-DOCUMENT-MANIFEST"
    },
    "version": {
      "const": "1.0.0"
    },
    "status": {
      "const": "draft"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "document_id",
          "owner_role",
          "review_state",
          "validation_status",
          "artifact_kind"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "document_id": {
            "type": "string",
            "minLength": 1
          },
          "owner_role": {
            "type": "string"
          },
          "review_state": {
            "enum": [
              "draft",
              "proposed",
              "source-evidence",
              "generated",
              "pending"
            ]
          },
          "validation_status": {
            "enum": [
              "pending",
              "structural-checked",
              "not-applicable-source"
            ]
          },
          "artifact_kind": {
            "enum": [
              "normative-document",
              "source",
              "registry",
              "schema",
              "contract",
              "example",
              "tooling",
              "report",
              "configuration"
            ]
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
